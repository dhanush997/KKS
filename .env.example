# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-host.region.neon.tech/dbname?sslmode=require"

# NextAuth Configuration
NEXTAUTH_SECRET="your_nextauth_jwt_secret_key_at_least_32_characters"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Nodemailer / Gmail SMTP Configuration
GMAIL_USER="your-gmail-address@gmail.com"
GMAIL_PASS="your-gmail-app-password" # App-specific password, not main account password

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis Configuration (Optional: defaults to bypass mode if empty)
REDIS_URL="redis://default:password@host:port"

# Google OAuth Configuration (NextAuth)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

